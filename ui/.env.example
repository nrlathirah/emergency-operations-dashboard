# Copy to .env and fill in.

# Where the API actually lives. This gets baked into the built frontend at
# build time (Vite env vars are compile-time, not read at runtime) — so a
# production build made with this still pointing at localhost will try to
# call localhost from every visitor's browser and fail outright. Set this
# to the real deployed API URL BEFORE running `npm run build` for anything
# other than local dev.
VITE_API_BASE_URL=http://localhost:4000/api
