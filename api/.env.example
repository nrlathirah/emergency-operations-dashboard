# Copy to .env and fill in. Never commit the real .env — it's already in
# .gitignore, keep it that way.

PORT=4000

# A long, random string used to sign login tokens — anyone who has it can
# forge a valid session for any user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres connection string (local dev can also fall back to SQLite —
# see src/config/database.js — but production should always be Postgres).
DATABASE_URL=

# --- Only needed once this is actually deployed somewhere ---

# The frontend's real origin(s), comma-separated for more than one
# (e.g. a staging and a production URL). Defaults to the local Vite dev
# server (http://localhost:5173) when unset — fine for local dev, but the
# browser will block every request from a deployed frontend until this is
# set to match it.
CORS_ORIGIN=

# Set to 1 once this sits behind a reverse proxy (Render, Railway, Fly.io,
# nginx — nearly every real host). Leave unset for local dev. See the
# comment in app.js for why this matters — it's what makes the rate
# limiters key on each real visitor's IP instead of the proxy's.
TRUST_PROXY=
